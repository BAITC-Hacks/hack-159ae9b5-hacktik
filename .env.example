# Optional: conversational AI with catalog, knowledge and map context.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: address search. Map selection and browser location work without a key.
GEOAPIFY_API_KEY=
# Persistent database, relative to the project directory.
EKT_DATABASE_PATH=data/ekt.sqlite3
# Seed clearly labeled sample listings and original demo catalog on first launch.
EKT_SEED_DEMO=true
# Set to your exact public origin when served behind a reverse proxy.
# Leave blank for local development.
PUBLIC_ORIGIN=
